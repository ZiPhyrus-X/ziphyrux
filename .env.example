# ==============================================================================
# ZIPHYRUS X ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure with deployment-specific credentials.
# NEVER commit real secret keys, service-role tokens, or passwords to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-EXPOSED CONFIGURATION (Prefix with VITE_ to expose to browser)
# ------------------------------------------------------------------------------
# Authentication adapter mode: 'api' for backend/Supabase API, 'dev-mock' for preview
VITE_AUTH_MODE=api

# Supabase Public API Endpoint (Safe for client browsers)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public / Publishable Anon Key (Safe for public operations with RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-anon-key

# Backend API base URL (Default: relative /api/v1 handled by TanStack Start / Nitro)
VITE_API_BASE_URL=/api/v1


# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER PREFIX WITH VITE_ - ABSOLUTELY NO BROWSER EXPOSURE)
# ------------------------------------------------------------------------------
# Supabase Privileged Service-Role Key (Backend authorization bypass for server ops)
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-never-expose-to-frontend

# PostgreSQL Direct Connection String (For server-side transactions & migrations)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# JWT Secret (Used for cryptographic token verification if verifying locally)
SUPABASE_JWT_SECRET=placeholder-jwt-verification-secret

# External Integration Credentials (Server-only)
GITHUB_APP_CLIENT_ID=placeholder-github-client-id
GITHUB_APP_CLIENT_SECRET=placeholder-github-client-secret
JUDGE_SERVICE_API_KEY=placeholder-coding-judge-api-key
EMAIL_PROVIDER_API_KEY=placeholder-email-provider-api-key
